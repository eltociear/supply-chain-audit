pkgbase=python-example
pkgname=('python-example' 'python-example-docs')
pkgver=3.1
pkgrel=1
arch=('any')
url="https://pypi.org/project/example"
license=('MIT')
makedepends=('python-build' 'python-installer' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/e/example/example-$pkgver.tar.gz")
sha256sums=('6666666666666666666666666666666666666666666666666666666666666666')
build() {
  cd "example-$pkgver"
  python -m build --wheel --no-isolation
}
package_python-example() {
  cd "example-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
package_python-example-docs() {
  install -d "$pkgdir/usr/share/doc/$pkgbase"
}
