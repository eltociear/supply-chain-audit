{
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {"ghcr.io/devcontainers/features/node:1": {}, "ghcr.io/devcontainers/features/docker-in-docker:2": {}},
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync",
  "postStartCommand": {"git": "git config --global --add safe.directory ${containerWorkspaceFolder}"},
  "runArgs": ["--privileged"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.cache",
  "customizations": {"vscode": {"extensions": ["ms-python.python"], "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}}}
}
